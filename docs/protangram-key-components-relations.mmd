flowchart LR
    subgraph FE["前端入口与壳层"]
        Main["main.tsx<br/>React 挂载入口"]
        App["App.tsx<br/>根组件<br/>启动同步数据"]
        ThemeProvider["ThemeProvider.tsx<br/>主题提供者"]
        Router["router/index.tsx<br/>路由表"]
        Layout["MainLayout.tsx<br/>导航 / 页签 / Outlet"]
        ThemeToggle["ThemeToggle.tsx<br/>主题切换"]
    end

    subgraph SS["状态与桥接层"]
        AppStore["useAppStore.ts<br/>全局业务状态"]
        ThemeStore["useThemeStore.ts<br/>主题状态"]
        Storage["storage.ts<br/>localStorage + 同步桥接"]
        Api["services/api.ts<br/>统一 API 调用层"]
    end

    subgraph BP["核心业务页面"]
        TemplatePage["TemplateCreate.tsx<br/>模板设计"]
        ExecutePage["AnalysisExecution.tsx<br/>分析执行"]
        Fullscreen["FullscreenPanel.tsx<br/>OUT 输出查看"]
        ReportCreatePage["ReportCreate.tsx<br/>报告创建"]
        ReportGeneratePage["ReportGenerate.tsx<br/>报告生成"]
    end

    subgraph BE["后端与数据层"]
        Backend["backend/src/index.js<br/>Express 服务入口"]
        JsonData["data/*/*.json<br/>本地持久化数据"]
    end

    subgraph DM["核心业务对象"]
        Experiment["ExperimentCard<br/>试验卡片 / 试验大纲"]
        TemplateModel["AnalysisTemplate<br/>模板节点与连线"]
        Project["AnalysisProject<br/>绑定试验与模板<br/>保存执行状态"]
        Report["AnalysisReport<br/>绑定标签并生成报告"]
    end

    Main -->|渲染| App
    App -->|包裹| ThemeProvider
    App -->|加载| Router
    Router -->|主框架| Layout
    Layout -->|使用| ThemeToggle
    Layout -->|Outlet 分发| TemplatePage
    Layout -->|Outlet 分发| ExecutePage
    Layout -->|Outlet 分发| ReportCreatePage
    Layout -->|Outlet 分发| ReportGeneratePage

    App -->|启动同步| Storage
    ThemeProvider -.读取主题.-> ThemeStore
    ThemeToggle -.切换主题.-> ThemeStore

    TemplatePage -.读写.-> AppStore
    ExecutePage -.读写.-> AppStore
    ReportCreatePage -.读写.-> AppStore
    ReportGeneratePage -.读写.-> AppStore

    TemplatePage -->|保存模板| Storage
    ExecutePage -->|保存项目进度| Storage
    ReportCreatePage -->|保存报告对象| Storage
    ReportGeneratePage -->|保存绑定与状态| Storage
    ExecutePage -->|OUT 结果展示| Fullscreen

    Storage -->|调用| Api
    Api -->|/api/*| Backend
    Backend -->|落盘| JsonData

    Experiment -->|提供试验上下文| Project
    TemplateModel -->|提供分析流程| Project
    Project -->|输出分析结果| Report

    TemplatePage -.创建 / 编辑.-> TemplateModel
    ExecutePage -.读取模板 / 更新项目.-> Project
    ReportCreatePage -.新建报告.-> Report
    ReportGeneratePage -.绑定 / 生成.-> Report

    AppStore -.持有.-> Experiment
    AppStore -.持有.-> TemplateModel
    AppStore -.持有.-> Project
    AppStore -.持有.-> Report

