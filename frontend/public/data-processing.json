{
  "algorithm_specification": {
    "version": "1.0.0",
    "base_url": "http://your-api-domain.com/v1/data-processing",
    "request_format": "JSON",
    "response_format": "JSON",
    "common_headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {your-api-token}"
    },
    "modules": [
      {
        "module_id": "statistical",
        "module_name": "统计类",
        "description": "基础统计特征计算，用于数据分布特征分析",
        "algorithms": [
          {
            "alg_id": "mean",
            "alg_name": "均值",
            "purpose": "计算数据序列的算术平均值，反映数据集中趋势",
            "webservice": {
              "endpoint": "/statistical/mean",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": [
                {
                  "param_name": "weights",
                  "param_type": "array",
                  "param_desc": "可选权重数组，长度需与data一致（非加权均值可不传）",
                  "example": [0.1, 0.2, 0.3, 0.4]
                }
              ]
            },
            "output": {
              "param_name": "mean_value",
              "param_type": "float",
              "param_desc": "计算得到的均值结果",
              "example": 4.4
            }
          },
          {
            "alg_id": "median",
            "alg_name": "中位数",
            "purpose": "计算数据序列的中位数，反映数据中间位置特征，抗异常值影响",
            "webservice": {
              "endpoint": "/statistical/median",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8, 9.2]
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "median_value",
              "param_type": "float",
              "param_desc": "计算得到的中位数结果",
              "example": 5.1
            }
          },
          {
            "alg_id": "range",
            "alg_name": "极差",
            "purpose": "计算数据最大值与最小值的差值，反映数据离散程度",
            "webservice": {
              "endpoint": "/statistical/range",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥2",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "range_value",
              "param_type": "float",
              "param_desc": "计算得到的极差结果（max - min）",
              "example": 6.6
            }
          },
          {
            "alg_id": "variance",
            "alg_name": "方差",
            "purpose": "计算数据序列的方差，反映数据偏离均值的程度",
            "webservice": {
              "endpoint": "/statistical/variance",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥2",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": [
                {
                  "param_name": "ddof",
                  "param_type": "int",
                  "param_desc": "自由度修正值，默认0（总体方差），1为样本方差",
                  "example": 1
                }
              ]
            },
            "output": {
              "param_name": "variance_value",
              "param_type": "float",
              "param_desc": "计算得到的方差结果",
              "example": 7.146666666666667
            }
          },
          {
            "alg_id": "std",
            "alg_name": "标准差",
            "purpose": "计算数据序列的标准差，方差的平方根，更直观反映数据离散程度",
            "webservice": {
              "endpoint": "/statistical/std",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥2",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": [
                {
                  "param_name": "ddof",
                  "param_type": "int",
                  "param_desc": "自由度修正值，默认0（总体标准差），1为样本标准差",
                  "example": 1
                }
              ]
            },
            "output": {
              "param_name": "std_value",
              "param_type": "float",
              "param_desc": "计算得到的标准差结果",
              "example": 2.673325020762359
            }
          }
        ]
      },
      {
        "module_id": "normalization",
        "module_name": "归一化/标准化类",
        "description": "数据尺度调整，消除量纲影响，适用于机器学习特征预处理",
        "algorithms": [
          {
            "alg_id": "min_max_norm",
            "alg_name": "最小最大归一化",
            "purpose": "将数据缩放到[0,1]区间，保留数据相对分布特征",
            "webservice": {
              "endpoint": "/normalization/min-max",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": [
                {
                  "param_name": "feature_range",
                  "param_type": "array",
                  "param_desc": "自定义缩放区间，默认[0,1]",
                  "example": [0, 10]
                }
              ]
            },
            "output": {
              "param_name": "normalized_data",
              "param_type": "array",
              "param_desc": "归一化后的数值序列",
              "example": [0.0, 0.38095238095238093, 0.6349206349206349, 1.0]
            }
          },
          {
            "alg_id": "standard_scaler",
            "alg_name": "标准化",
            "purpose": "将数据转换为均值0、标准差1的标准正态分布，适用于对异常值敏感的模型",
            "webservice": {
              "endpoint": "/normalization/standard",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥2",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "standardized_data",
              "param_type": "array",
              "param_desc": "标准化后的数值序列",
              "example": [-1.2041199826559248, -0.3374057093016922, 0.24082399653118496, 1.300691695426432]
            }
          },
          {
            "alg_id": "centralization",
            "alg_name": "中心化",
            "purpose": "将数据减去均值，使数据围绕0分布，保留离散程度",
            "webservice": {
              "endpoint": "/normalization/centralize",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "centralized_data",
              "param_type": "array",
              "param_desc": "中心化后的数值序列",
              "example": [-3.2, -0.9, 0.7, 3.4]
            }
          },
          {
            "alg_id": "regularization",
            "alg_name": "正则化",
            "purpose": "将数据转换为单位范数（L1/L2），适用于需要统一向量长度的场景",
            "webservice": {
              "endpoint": "/normalization/regularize",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
                },
                {
                  "param_name": "norm",
                  "param_type": "string",
                  "param_desc": "正则化类型，可选'l1'/'l2'",
                  "example": "l2"
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "regularized_data",
              "param_type": "array",
              "param_desc": "正则化后的数值序列",
              "example": [0.1143238514529076, 0.3342970110700018, 0.4865905674484014, 0.7437885699286892]
            }
          },
          {
            "alg_id": "interval_mapping",
            "alg_name": "区间映射",
            "purpose": "将数据从原区间线性映射到指定目标区间",
            "webservice": {
              "endpoint": "/normalization/interval-map",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
                },
                {
                  "param_name": "source_range",
                  "param_type": "array",
                  "param_desc": "数据原始区间 [min, max]",
                  "example": [1.2, 7.8]
                },
                {
                  "param_name": "target_range",
                  "param_type": "array",
                  "param_desc": "目标映射区间 [min, max]",
                  "example": [10, 20]
                }
              ],
              "optional": []
            },
            "output": {
              "param_name": "mapped_data",
              "param_type": "array",
              "param_desc": "区间映射后的数值序列",
              "example": [10.0, 13.809523809523809, 16.349206349206348, 20.0]
            }
          },
          {
            "alg_id": "feature_scaling",
            "alg_name": "特征缩放",
            "purpose": "按指定比例缩放特征值，统一不同特征的尺度",
            "webservice": {
              "endpoint": "/normalization/feature-scale",
              "method": "POST",
              "timeout": 5000
            },
            "input": {
              "required": [
                {
                  "param_name": "data",
                  "param_type": "array",
                  "param_desc": "数值型数据序列，不能为空且长度≥1",
                  "example": [1.2, 3.5, 5.1, 7.8]
